# secrets
.env

# база: Telegram id каждого допущенного пилота, его маршруты и координаты
# стартов. Сюда её кладёт bare-metal раскатка (store.DB_PATH по умолчанию —
# <репозиторий>/data/pgbot.db), и без этой строки первый же `git add -A`
# унёс бы её в историю. В Docker БД живёт в томе pgbot-data.
data/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# rendered systemd unit (machine-specific; generated by deploy.sh)
deploy/pgbot.service

# os
.DS_Store

# pytest
.pytest_cache/

# superpowers scratch (SDD workspace)
.superpowers/

# webapp (Vite + React)
webapp/node_modules
webapp/dist
# следы прогонов Playwright: снимки и трассы упавших сценариев (test-results,
# outputDir по умолчанию) и HTML-отчёт, если его попросили ключом --reporter.
# Сами браузеры Playwright кладёт мимо репозитория (~/Library/Caches или
# ~/.cache/ms-playwright), поэтому исключать их не нужно.
webapp/test-results
webapp/playwright-report
webapp/blob-report
