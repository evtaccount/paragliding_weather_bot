# Домен приходит из окружения (см. .env.example).
{$PUBLIC_DOMAIN} {
	# Пусто — и Caddy сам выпускает Let's Encrypt на {$PUBLIC_DOMAIN} и сам
	# продлевает. Автоматика включается именно ОТСУТСТВИЕМ директивы tls:
	# ключевого слова «выпусти сам» у Caddy нет.
	#
	# Свой сертификат подключается оверлеем docker-compose.own-cert.yml — он
	# монтирует сюда deploy/caddy/own-cert/tls.caddy, и директива приезжает
	# этой строкой. В автоматическом режиме каталога нет вовсе; маска не
	# совпадает ни с чем, caddy пишет в лог «No files matching import glob
	# pattern» и продолжает — это ожидаемо, чинить нечего.
	import /etc/caddy/tls/*.caddy

	encode zstd gzip

	# Порядок обязателен: handle для /api/* стоит выше, иначе file_server
	# отдал бы 404 на каждый запрос приложения. Именно handle, а не
	# handle_path: handle_path срезает совпавший префикс из пути, и API
	# получил бы "/health" вместо "/api/health" — 404 на каждый запрос.
	handle /api/* {
		reverse_proxy pgbot:{$API_PORT:8080}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
