# Домен приходит из окружения (см. .env.example).
{$PUBLIC_DOMAIN} {
	# Пусто — и Caddy сам выпускает Let's Encrypt на {$PUBLIC_DOMAIN} и сам
	# продлевает. Автоматика включается именно ОТСУТСТВИЕМ директивы tls:
	# ключевого слова «выпусти сам» у Caddy нет.
	#
	# Свой сертификат подключается оверлеем docker-compose.own-cert.yml — он
	# монтирует сюда deploy/caddy/own-cert/tls.caddy, и директива приезжает
	# этой строкой. В автоматическом режиме каталога нет вовсе; маска не
	# совпадает ни с чем, caddy пишет в лог «No files matching import glob
	# pattern» и продолжает — это ожидаемо, чинить нечего.
	import /etc/caddy/tls/*.caddy

	encode zstd gzip

	# Порядок обязателен: handle для /api/* стоит выше, иначе file_server
	# отдал бы 404 на каждый запрос приложения. Именно handle, а не
	# handle_path: handle_path срезает совпавший префикс из пути, и API
	# получил бы "/health" вместо "/api/health" — 404 на каждый запрос.
	handle /api/* {
		reverse_proxy pgbot:{$API_PORT:8080}
	}

	# Тайлы идут через свой домен, а не напрямую к tile.openstreetmap.org:
	# прямой запрос с устройства пилота отдал бы чужому серверу и адрес
	# устройства, и район, куда он смотрит. Правила использования тайлов
	# OpenStreetMap требуют, чтобы клиент себя называл в User-Agent —
	# безымянный поток запросов там блокируют, поэтому header_up переписывает
	# его на имя приложения перед отправкой апстриму. Блок стоит выше общего
	# handle — иначе тот отдал бы файл (или 404) на путь /tiles/*, до прокси
	# дело не дошло бы.
	#
	# uri strip_prefix обязателен: клиент шлёт /tiles/{z}/{x}/{y}.png (см.
	# webapp/src/map/MapView.tsx), а OpenStreetMap отдаёт тайлы по
	# /{z}/{x}/{y}.png, БЕЗ префикса /tiles (см. канонический шаблон в
	# webapp/node_modules/leaflet/src/layer/tile/TileLayer.js). Без среза
	# наверх уходил бы буквально /tiles/10/637/380.png, и апстрим отвечал бы
	# 404 на каждый тайл. Ровно симметричная (и ровно противоположная по
	# знаку) история блоку /api/* выше: там handle_path срезал бы префикс,
	# который бэкенду как раз нужен, поэтому там стоит handle и НЕ срезает;
	# здесь handle префикс сохраняет, а тайловому серверу он как раз мешает —
	# поэтому срез сделан явно директивой uri strip_prefix, а не сменой
	# handle на handle_path (это заодно оставило бы неотличимым по тексту сам
	# путь /tiles/* в конфиге).
	handle /tiles/* {
		uri strip_prefix /tiles
		reverse_proxy https://tile.openstreetmap.org {
			header_up Host tile.openstreetmap.org
			header_up User-Agent "paragliding-bot-miniapp/1.0 (+https://{$PUBLIC_DOMAIN})"
		}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
