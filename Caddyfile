# Домен и пути к сертификату приходят из окружения (см. .env.example).
{$PUBLIC_DOMAIN} {
	# Свой купленный сертификат. Чтобы Caddy выпускал Let's Encrypt сам,
	# удалить эту строку целиком — всё остальное менять не нужно.
	tls /certs/fullchain.pem /certs/privkey.pem

	encode zstd gzip

	# Порядок обязателен: handle для /api/* стоит выше, иначе file_server
	# отдал бы 404 на каждый запрос приложения. Именно handle, а не
	# handle_path: handle_path срезает совпавший префикс из пути, и API
	# получил бы "/health" вместо "/api/health" — 404 на каждый запрос.
	handle /api/* {
		reverse_proxy pgbot:{$API_PORT:8080}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
