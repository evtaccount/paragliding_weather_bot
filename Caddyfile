# Домен приходит из окружения (см. .env.example).
{$PUBLIC_DOMAIN} {
	# Пусто — и Caddy сам выпускает Let's Encrypt на {$PUBLIC_DOMAIN} и сам
	# продлевает. Автоматика включается именно ОТСУТСТВИЕМ директивы tls:
	# ключевого слова «выпусти сам» у Caddy нет.
	#
	# Свой сертификат подключается оверлеем docker-compose.own-cert.yml — он
	# монтирует сюда deploy/caddy/own-cert/tls.caddy, и директива приезжает
	# этой строкой. В автоматическом режиме каталога нет вовсе; маска не
	# совпадает ни с чем, caddy пишет в лог «No files matching import glob
	# pattern» и продолжает — это ожидаемо, чинить нечего.
	import /etc/caddy/tls/*.caddy

	encode zstd gzip

	# Потолок тела — на всю площадку, а не внутри одного handle: тело
	# оплачивается ещё до того, как станет ясно, кому оно адресовано.
	# Замерено на живом сервере (финальное ревью ветки, безопасность, I1):
	# POST /api/routes с телом 800 МБ и БЕЗ заголовка Authorization поднял RSS
	# процесса с 38 до 635 МБ, и только потом ответил 401 — FastAPI читает тело
	# раньше, чем решает зависимости; multipart на 600 МБ тем же путём вырастил
	# временный файл до 594 МБ, а лежит он рядом с SQLite. Через живой Caddy
	# без этой директивы доезжало 400 МБ. Домен посторонний узнаёт сам:
	# Let's Encrypt публикует каждое выпущенное имя в Certificate Transparency.
	#
	# Тот же потолок продублирован в api.py (MAX_BODY_BYTES): не дубль знания, а
	# две границы на разных путях — Caddy закрывает доступ снаружи, api.py
	# закрывает bare-metal раскатку (deploy.sh), где Caddy впереди нет вовсе.
	# 2 МиБ = 1 МиБ route.MAX_GPX_BYTES (законный трек) плюс запас на обвязку
	# multipart. Единица именно MiB, а не MB: у Caddy MB — это 1 000 000, и
	# «2MB» разошлось бы с 2*1024*1024 в api.py на 97 152 байта.
	#
	# Замерено на этом же файле в живом caddy:2-alpine (2.11.4) с приёмником
	# вместо бэкенда: 8 МБ с Content-Length — клиенту 413, до бэкенда доезжает
	# не больше max_size (2 097 152 байта, дальше обрыв); те же 8 МБ chunked,
	# без Content-Length — до бэкенда не доходит ВООБЩЕ, соединение рвётся.
	# Законные 100 КБ и тело ровно в потолок доезжают целиком.
	request_body {
		max_size 2MiB
	}

	# Блок стоит отдельно, хотя общий handle ниже ведёт в тот же pgbot: он
	# фиксирует, что до бэкенда доезжает ПОЛНЫЙ путь. Именно
	# handle, а не handle_path: handle_path срезает совпавший префикс из
	# пути, и uvicorn получил бы "/health" вместо "/api/health" — роутер в
	# api.py объявлен с prefix="/api", то есть 404 на каждый запрос
	# приложения.
	handle /api/* {
		reverse_proxy pgbot:{$API_PORT:8080}
	}

	# Тайлы идут через свой домен, а не напрямую к tile.openstreetmap.org:
	# прямой запрос с устройства пилота отдал бы чужому серверу и адрес
	# устройства, и район, куда он смотрит. Правила использования тайлов
	# OpenStreetMap требуют, чтобы клиент себя называл в User-Agent —
	# безымянный поток запросов там блокируют, поэтому header_up переписывает
	# его на имя приложения перед отправкой апстриму. Отдельный блок, а не
	# часть общего handle: handle-блоки взаимно исключающие, и /tiles/*
	# перехватывается здесь, не доходя до прокси в pgbot, где тайлов нет.
	# Порядок в файле при этом ни при чём — Caddy сортирует handle сам, блок
	# без матчера уходит последним (видно в выводе `caddy adapt`: маршрут с
	# path /tiles/* стоит выше безматчерного, как его в файле ни двигай).
	#
	# uri strip_prefix обязателен: клиент шлёт /tiles/{z}/{x}/{y}.png (см.
	# webapp/src/map/MapView.tsx), а OpenStreetMap отдаёт тайлы по
	# /{z}/{x}/{y}.png, БЕЗ префикса /tiles (см. канонический шаблон в
	# webapp/node_modules/leaflet/src/layer/tile/TileLayer.js). Без среза
	# наверх уходил бы буквально /tiles/10/637/380.png, и апстрим отвечал бы
	# 404 на каждый тайл. Ровно симметричная (и ровно противоположная по
	# знаку) история блоку /api/* выше: там handle_path срезал бы префикс,
	# который бэкенду как раз нужен, поэтому там стоит handle и НЕ срезает;
	# здесь handle префикс сохраняет, а тайловому серверу он как раз мешает —
	# поэтому срез сделан явно директивой uri strip_prefix, а не сменой
	# handle на handle_path (это заодно оставило бы неотличимым по тексту сам
	# путь /tiles/* в конфиге).
	#
	# Наверх уходит только то, что действительно похоже на тайл. Без этой
	# рамки блок был ретранслятором на OpenStreetMap для любого метода и пути:
	# проверено на живом Caddy — `POST /tiles/anything` с телом доезжал до
	# апстрима как `POST /anything`, и с нашим User-Agent. Открытым прокси блок
	# и тогда не был (абсолютный URI, CONNECT, /tiles/../x и /tiles/..%2f..%2fx
	# отбиты), но правила OpenStreetMap банят именно по User-Agent, а он
	# захардкожен именно как наш — бан прилетел бы приложению, и карта погасла
	# бы у пилота, оплатившего чужой трафик своим VPS (финальное ревью ветки,
	# безопасность, m3).
	#
	# Фигурных скобок в регулярном выражении нет намеренно: в Caddyfile {…} —
	# синтаксис плейсхолдеров, и квантификатор вида [0-9]{1,2} читается уже не
	# как регулярное выражение. Поэтому «одна-две цифры зума» записаны как
	# [0-9][0-9]?.
	handle /tiles/* {
		@tile {
			method GET HEAD
			path_regexp ^/tiles/[0-9][0-9]?/[0-9]+/[0-9]+\.png$
		}
		handle @tile {
			uri strip_prefix /tiles
			reverse_proxy https://tile.openstreetmap.org {
				header_up Host tile.openstreetmap.org
				header_up User-Agent "paragliding-bot-miniapp/1.0 (+https://{$PUBLIC_DOMAIN})"
				# Ради этих трёх строк прокси и заведён. Caddy добавляет
				# X-Forwarded-For сам, и на живом Caddy апстрим видел в нём
				# адрес устройства пилота (замерено: 192.168.65.1), а рядом
				# X-Forwarded-Host и Via — то есть прямой запрос к
				# tile.openstreetmap.org мы заменили на такой же, но с лишним
				# посредником (финальное ревью ветки, безопасность, m1).
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				header_up -Via
				# Заголовки проходили насквозь в обе стороны: клиентские
				# Cookie и Authorization доезжали до апстрима дословно, а его
				# Set-Cookie возвращался в браузер на НАШ домен. Сегодня на
				# домене кук нет, поэтому не стреляет; стрельнёт в день, когда
				# заведут первую — каждая плитка карты повезёт её чужому
				# серверу (m2).
				header_up -Cookie
				header_up -Authorization
				header_down -Set-Cookie
			}
		}
		# Всё, что не тайл, дальше этой строки не идёт. respond, а не
		# reverse_proxy в pgbot: путь /tiles/* принадлежит карте, и молча
		# отдавать по нему приложение значит прятать ошибку.
		respond 404
	}

	# Всё остальное — тоже в pgbot: собранное приложение лежит внутри его
	# образа (Dockerfile, этап webapp), и отдаёт его сам pgbot — api.py
	# монтирует webapp/dist на "/". Caddy файлы с диска здесь не читает: ему
	# пришлось бы монтировать тот же каталог томом, а это второй путь к тому
	# же артефакту — после первой же пересборки образа том показывал бы
	# старую сборку, и правка во фронтенде «не доезжала» бы без внятной
	# причины.
	handle {
		reverse_proxy pgbot:{$API_PORT:8080}
	}
}
