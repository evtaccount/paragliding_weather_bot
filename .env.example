# Telegram bot token — get from @BotFather
BOT_TOKEN=123456789:AA...

# Google Gemini API key (free tier) — https://aistudio.google.com/apikey
# Gemini ANALYSES the real open-meteo data (verdict, best day, hazards).
# Optional: without it the bot falls back to the built-in rule-based analysis.
GEMINI_API_KEY=AIza...

# Optional: Gemini model selection. The bot tries a chain of models in order and
# falls through to the next if one fails (unavailable / error / empty response);
# only if ALL fail does it use the built-in rule-based analysis.
#   GEMINI_MODELS — comma-separated list, overrides the whole chain.
#   GEMINI_MODEL  — a single model tried FIRST, then the built-in chain as fallback.
# Built-in default chain: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Access control: comma-separated Telegram user IDs allowed to use the bot.
# Empty/unset = bot is OPEN to everyone (a warning is logged). Find your ID:
# message the bot while not whitelisted — it replies with your ID (or use @userinfobot).
ALLOWED_USER_IDS=

# Rate limiting: min seconds between forecast requests per user (default 10).
COOLDOWN_SEC=10

# Forecast cache TTL in minutes (default 15) — repeat requests for the same
# site/range are served from memory, without calling open-meteo or Gemini.
CACHE_TTL_MIN=15

# Файл базы. По умолчанию — data/pgbot.db рядом с кодом; в контейнере
# перекрывается на /app/data/pgbot.db (том с правами на запись).
DB_PATH=
