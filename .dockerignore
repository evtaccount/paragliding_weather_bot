# dist собирается этапом webapp внутри образа, локальная сборка ему не нужна —
# и не должна попадать: контекст с хоста мог бы оказаться старее исходников.
webapp/dist
# В образе не исполняется ничто из перечисленного: процесс запускает app.py.
# .superpowers — это ~2,3 МБ рабочих материалов разработки, попадавших в слой
# вместе с `COPY . .`. scripts/ — инструменты разработчика, и один из них
# (dump_api_fixtures.py) всё равно читает tests/, которых в образе уже нет.
.superpowers
.pytest_cache
.vscode
tests
docs
scripts
